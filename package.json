{
  "name": "chashitsu-visual-editor",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build-editor.mjs",
    "dev": "node scripts/dev-editor.mjs",
    "db:generate": "drizzle-kit generate",
    "test": "node --test tests/editor-api.test.mjs",
    "format": "prettier --write src worker scripts db tests README.md package.json",
    "test:unit": "node --test tests/editor-cms-validation.test.mjs",
    "db:local": "wrangler d1 migrations apply DB --local --config dist/server/wrangler.json --persist-to .wrangler/state"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2"
  },
  "devDependencies": {
    "drizzle-kit": "0.31.10",
    "esbuild": "^0.27.4",
    "playwright": "^1.63.0",
    "prettier": "^3.9.9",
    "wrangler": "4.92.0"
  }
}
